# Flask Configuration
FLASK_APP=backend/wsgi.py
FLASK_ENV=development
SECRET_KEY=your_secret_key_here_change_in_production

# Database Configuration
DATABASE_URL=postgresql+psycopg2://nexoritham:your_password@localhost:5432/nexoritham

# JWT Configuration
JWT_SECRET_KEY=your_jwt_secret_key_here_change_in_production
JWT_ACCESS_TOKEN_EXPIRES=900          # 15 minutes in seconds
JWT_REFRESH_TOKEN_EXPIRES=604800      # 7 days in seconds

# Security
BCRYPT_LOG_ROUNDS=12
FORCE_HTTPS=false

# CORS (comma-separated allowed origins)
CORS_ORIGINS=http://localhost:5000,http://127.0.0.1:5000

# Rate Limiting
RATELIMIT_STORAGE_URL=memory://